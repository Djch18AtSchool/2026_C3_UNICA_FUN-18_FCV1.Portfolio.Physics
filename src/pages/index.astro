---
import { getCollection } from 'astro:content';
import TopicCard from '../components/nav/TopicCard.astro';
import GithubIcon from '../components/ui/GithubIcon.astro';
import { AUTHOR, COURSE, REPO_URL } from '../consigna';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LAST_UPDATE_ISO, LAST_UPDATE_LABEL } from '../lib/lastUpdate';
import { groupByPhase } from '../lib/phases';
import { sortByNumber, toTopicSummary } from '../lib/topics';

const entries = sortByNumber(
  (await getCollection('topics')).map((entry) => ({ ...toTopicSummary(entry), entry })),
);

// Future phases (no topics yet) show only their heading and a dashed badge: no rows or counts.
const groups = groupByPhase(entries);
/** «Se publica con su consigna»: a dashed frame (navigation.spec.ts checks it). */
const UPCOMING_BADGE =
  // scale-exempt: a dashed frame marks a state (published with its brief), not a separator
  'inline-flex shrink-0 items-center rounded-base border border-dashed border-fg-muted px-2 py-px text-xs leading-5 whitespace-nowrap text-fg-muted';
---

<BaseLayout title="Portafolio de evidencias de Física I">
  <section aria-labelledby="titulo-portada" class="border-b border-border pb-12">
    <h1 id="titulo-portada" class="max-w-[16ch] text-4xl">
      Portafolio de evidencias de Física&nbsp;I
    </h1>
    <p class="measure mt-6 text-lg leading-relaxed">
      Este portafolio documenta cómo la física del curso aparece en el desarrollo de software: cada
      tema parte de un producto real, plantea la ecuación que lo gobierna y la acompaña con un
      recurso para explorarla.
    </p>

    <dl class="mt-8 flex flex-col gap-3 text-sm sm:max-w-md" data-testid="cover-meta">
      <div class="flex flex-col gap-1">
        <dt class="text-xs text-fg-muted">Autor</dt>
        <dd>{AUTHOR}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-xs text-fg-muted">Universidad</dt>
        <dd>{COURSE.university}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-xs text-fg-muted">Curso</dt>
        <dd>{COURSE.name}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-xs text-fg-muted">Docente</dt>
        <dd>{COURSE.professor}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-xs text-fg-muted">Última actualización</dt>
        <dd>
          <time datetime={LAST_UPDATE_ISO}>{LAST_UPDATE_LABEL}</time>
        </dd>
      </div>
    </dl>

    <a
      href={REPO_URL}
      class="mt-6 inline-flex items-center gap-2 rounded-base border border-border bg-bg-elevated px-4 py-2 text-sm font-medium text-fg no-underline transition-colors hover:border-fg-muted"
    >
      <GithubIcon variant="outline" />
      Ver repositorio
    </a>
  </section>

  <div class="mt-12 flex flex-col gap-12">
    {groups.map((group) => (
      <section
        id={`fase-${group.phase}`}
        data-testid="phase-group"
        aria-labelledby={`fase-${group.phase}-titulo`}
        class="scroll-mt-8"
      >
        <div class="flex flex-col items-start gap-x-4 gap-y-2 border-b-(length:--rule-double-width) border-double border-border pb-2 sm:flex-row sm:items-center sm:justify-between">
          <h2 id={`fase-${group.phase}-titulo`}>{group.label}</h2>
          {group.isFuture && (
            <span data-testid="upcoming-phase" class={UPCOMING_BADGE}>
              Se publica con su consigna
            </span>
          )}
        </div>
        {!group.isFuture && (
          <ol class="divide-y divide-border border-b border-border">
            {group.topics.map((topic) => (
              <li>
                <TopicCard topic={topic} />
              </li>
            ))}
          </ol>
        )}
      </section>
    ))}
  </div>
</BaseLayout>
