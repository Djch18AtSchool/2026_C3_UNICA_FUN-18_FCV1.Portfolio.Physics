---
import { getCollection } from 'astro:content';
import TopicCard from '../components/nav/TopicCard.astro';
import { AUTHOR, COURSE, PHASE_LABELS, PHASES, REPO_URL, topicsByPhase } from '../consigna';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUILD_DATE_ISO, BUILD_DATE_LABEL } from '../lib/buildDate';
import { sortByNumber, toTopicSummary } from '../lib/topics';

const entries = sortByNumber(
  (await getCollection('topics')).map((entry) => ({ ...toTopicSummary(entry), entry })),
);

const groups = PHASES.map((phase) => ({
  phase,
  label: PHASE_LABELS[phase],
  topics: topicsByPhase(phase, entries),
}));
---

<BaseLayout title="Portafolio de evidencias de Física I">
  <section aria-labelledby="titulo-portada" class="border-b border-border pb-12">
    <h1 id="titulo-portada" class="max-w-[16ch] text-[2.5rem] sm:text-5xl">
      Portafolio de evidencias de Física I
    </h1>
    <p class="measure mt-6 text-lg leading-relaxed">
      Este portafolio documenta cómo la física del curso aparece en el desarrollo de software: cada
      tema parte de un producto real, plantea la ecuación que lo gobierna y la acompaña con un
      recurso para explorarla.
    </p>

    <dl class="mt-8 flex flex-col gap-3 text-sm sm:max-w-md" data-testid="cover-meta">
      <div class="flex flex-col gap-0.5">
        <dt class="text-xs text-fg-muted">Autor</dt>
        <dd>{AUTHOR}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-xs text-fg-muted">Universidad</dt>
        <dd>
          {COURSE.university} · {COURSE.school}
        </dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-xs text-fg-muted">Curso</dt>
        <dd>
          <span class="font-mono">{COURSE.code}</span> {COURSE.name}
          {' · Sección '}
          <span class="font-mono">{COURSE.section}</span>
          {' · '}
          <span class="font-mono">{COURSE.period}</span>
        </dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-xs text-fg-muted">Docente</dt>
        <dd>{COURSE.professor}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-xs text-fg-muted">Última actualización</dt>
        <dd>
          <time datetime={BUILD_DATE_ISO}>{BUILD_DATE_LABEL}</time>
        </dd>
      </div>
    </dl>

    <a
      href={REPO_URL}
      class="mt-6 inline-flex h-9 items-center gap-2 rounded-base border border-border px-3 text-sm text-fg-muted transition-colors hover:border-fg-muted hover:text-fg"
    >
      <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      Ver repositorio
    </a>
  </section>

  <div class="mt-12 flex flex-col gap-14">
    {groups.map((group) => (
      <section
        id={`fase-${group.phase}`}
        data-testid="phase-group"
        aria-labelledby={`fase-${group.phase}-titulo`}
        class="scroll-mt-8"
      >
        <div class="border-b-[3px] border-double border-border pb-2">
          <h2 id={`fase-${group.phase}-titulo`}>{group.label}</h2>
        </div>
        <ol class="divide-y divide-border border-b border-border">
          {group.topics.map((topic) => (
            <li>
              <TopicCard topic={topic} product={topic.entry.data.useCase?.product} />
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
