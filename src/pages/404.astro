---
import SideNav from '../components/nav/SideNav.astro';
import { loadSidebarData } from '../components/nav/sidebarData';
import BaseLayout from '../layouts/BaseLayout.astro';
import { latestPublishedPhase } from '../lib/topics';
import { withBase } from '../lib/url';
import { SIDEBAR_ID } from '../lib/navState';

const { all, index, outlines } = await loadSidebarData();
---

<BaseLayout title="Página no encontrada | Física I" hasCanonical={false} hasSidebar>
  <div class="sidebar-layout grid gap-8 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
    <div
      id={SIDEBAR_ID}
      class="sidebar-column lg:sticky lg:top-8 lg:max-h-[calc(100dvh-4rem)] lg:self-start lg:overflow-y-auto"
    >
      <SideNav
        topics={all}
        outlines={outlines}
        index={index}
        currentPhase={latestPublishedPhase(all)}
        isOpen
      />
    </div>
    <div>
      <section class="grid-paper rounded-base border border-border px-5 py-6 sm:px-8 sm:py-8">
        <div class="measure rounded-base border border-border bg-bg-elevated p-5 sm:p-6">
          <p class="font-mono text-sm text-fg-muted">404</p>
          <h1 class="mt-1">Página no encontrada</h1>
          <p class="mt-3">
            Esta dirección no corresponde a ninguna página del portafolio. Elige un tema en la lista
            o vuelve a la portada para ver los trece temas por avance.
          </p>
          <p class="mt-5">
            <a href={withBase('')}>Volver a la portada</a>
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
