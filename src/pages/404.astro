---
import { getCollection } from 'astro:content';
import SideNav from '../components/nav/SideNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortByNumber, toTopicSummary } from '../lib/topics';
import { withBase } from '../lib/url';

const all = sortByNumber((await getCollection('topics')).map(toTopicSummary));
---

<BaseLayout title="Página no encontrada | Física I">
  <div class="grid gap-8 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
    <div class="lg:sticky lg:top-8 lg:self-start">
      <SideNav topics={all} isOpen />
    </div>
    <div>
      <section class="grid-paper rounded-base border border-border px-5 py-6 sm:px-8 sm:py-8">
        <div class="measure rounded-base border border-border bg-bg-elevated p-5 sm:p-6">
          <p class="font-mono text-sm text-fg-muted">404</p>
          <h1 class="mt-1">Página no encontrada</h1>
          <p class="mt-3">
            Esta dirección no corresponde a ninguna página del portafolio. Elige un tema en la lista
            o vuelve a la portada para ver los trece temas por avance.
          </p>
          <p class="mt-5">
            <a href={withBase('')}>Volver a la portada</a>
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
