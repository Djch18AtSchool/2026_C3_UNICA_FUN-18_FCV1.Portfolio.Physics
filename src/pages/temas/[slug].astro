---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import TopicLayout from '../../layouts/TopicLayout.astro';
import { topicByNumber } from '../../consigna';
import { sortByNumber, toTopicSummary } from '../../lib/topics';

export const getStaticPaths = (async () => {
  const entries = await getCollection('topics');
  const all = sortByNumber(entries.map(toTopicSummary));
  return entries.map((entry) => {
    const expectedSlug = topicByNumber(entry.data.number)?.slug;
    if (entry.id !== expectedSlug) {
      throw new Error(
        `El archivo "${entry.id}.mdx" declara el tema ${entry.data.number}, cuyo slug en consigna.ts es "${expectedSlug}".`,
      );
    }
    return { params: { slug: entry.id }, props: { entry, all } };
  });
}) satisfies GetStaticPaths;

const { entry, all } = Astro.props;
const { Content } = await render(entry);
---

<TopicLayout topic={{ ...entry.data, slug: entry.id }} all={all}>
  <Content />
</TopicLayout>
