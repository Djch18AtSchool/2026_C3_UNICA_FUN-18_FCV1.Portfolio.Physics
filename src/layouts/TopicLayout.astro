---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/nav/Breadcrumbs.astro';
import PrevNext from '../components/nav/PrevNext.astro';
import ReadingProgress from '../components/nav/ReadingProgress.astro';
import SideNav from '../components/nav/SideNav.astro';
import TopicMeta from '../components/nav/TopicMeta.astro';
import TopicStickyBar from '../components/nav/TopicStickyBar.astro';
import { COURSE, PHASE_LABELS } from '../consigna';
import type { TopicData } from '../content/topicSchema';
import type { SearchEntry, SearchHeading } from '../lib/searchIndex';
import type { TopicSummary } from '../lib/topics';
import { SIDEBAR_ID } from '../lib/navState';
import { bindNumerals } from '../lib/typography';

interface Props {
  topic: TopicData & { slug: string };
  /** All topics, sorted by number. */
  all: TopicSummary[];
  /** Section headings of each topic, for the sidebar outlines. */
  outlines: Record<string, SearchHeading[]>;
  /** Build-time search index for the sidebar. */
  index: SearchEntry[];
  /** The topic's raw MDX body, for the reading time and "Copiar Markdown". */
  body: string;
}
const { topic, all, outlines, index, body } = Astro.props;
const { slug, number, phase, title, shortTitle, concept, resourceType, updated } = topic;

const phaseLabel = PHASE_LABELS[phase];
---

<BaseLayout title={`Tema ${number}: ${title} | ${COURSE.name}`} description={concept}>
  <ReadingProgress />
  <div class="grid gap-8 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
    <div
      id={SIDEBAR_ID}
      class="lg:sticky lg:top-8 lg:max-h-[calc(100dvh-4rem)] lg:self-start lg:overflow-y-auto"
    >
      <SideNav topics={all} current={slug} outlines={outlines} index={index} currentPhase={phase} />
    </div>

    <article class="flex min-w-0 flex-col gap-12">
      <!-- The bar is zero-height and only exists at lg; cancel the article gap it would add. -->
      <TopicStickyBar
        class="lg:-mb-12"
        number={number}
        phaseLabel={phaseLabel}
        shortTitle={shortTitle}
        resourceType={resourceType}
      />
      <div class="flex flex-col gap-6">
        <Breadcrumbs number={number} phase={phase} />
        <header data-topic-head>
          <h1>{bindNumerals(title)}</h1>
          <p class="measure mt-4 text-lg leading-relaxed">{concept}</p>
          <TopicMeta slug={slug} resourceType={resourceType} updated={updated} body={body} />
        </header>
      </div>

      <div class="topic-body" data-topic-number={number} style={`counter-set: topic ${number}`}>
        <slot />
      </div>

      <PrevNext all={all} number={number} />
    </article>
  </div>
</BaseLayout>
