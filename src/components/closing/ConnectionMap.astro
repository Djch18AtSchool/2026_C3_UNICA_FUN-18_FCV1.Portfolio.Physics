---
/*
 * «Qué aprendí» (a): the map of the topics, one column per delivery, with every `related` link in
 * a faint stroke and the three pairs in colour, each with its principle on its edge. Drawn at
 * 1:1 (its text at the site's 14 and 12 px): the figure frame scrolls on narrow screens, and the
 * pairs are written out below anyway (ClosingPair). Layout in src/lib/closing.ts.
 */
import Figure from '../ui/Figure.astro';
import {
  CLOSING_PAIRS,
  MAP_TYPE,
  MAP_WIDTH,
  NODE_NUMBER_GAP,
  NODE_NUMBER_WIDTH,
  NODE_PAD_X,
  connectionMap,
  type FaintEdge,
  type PairEdge,
} from '../../lib/closing';
import { topicNumberLabel } from '../../lib/phases';
import { loadClosingTopics, pairColor } from './closingData';

const FAINT_STROKE = 1;
const PAIR_STROKE = 3;
const NODE_STROKE = 1;
const PAIR_NODE_STROKE = 2;
const RADIUS = 4;
/** Baselines that centre 12 and 14 px Plex in a box (about a third of the size below centre). */
const BASELINE_12 = 4;
const BASELINE_14 = 5;
const COLUMN_BASELINE = 12;
const TITLE_ID = 'mapa-conexiones-titulo';
const DESC_ID = 'mapa-conexiones-descripcion';

const { topics, related } = await loadClosingTopics();
const map = connectionMap(topics, related, CLOSING_PAIRS, MAP_WIDTH);
const pairs = map.edges.filter((edge): edge is PairEdge => edge.isPair);
const faint = map.edges.filter((edge): edge is FaintEdge => !edge.isPair);
/** The colour of the pair a topic belongs to, if any. */
const nodeColor = new Map(
  pairs.flatMap((edge) => [
    [edge.a, pairColor(edge.principle)],
    [edge.b, pairColor(edge.principle)],
  ]),
);
const topicName = (number: number) => {
  const topic = topics.find((candidate) => candidate.number === number);
  return topic ? `el Tema ${number} (${topic.shortTitle})` : `el Tema ${number}`;
};
const description = [
  `Los ${map.nodes.length} temas en tres columnas, una por entrega, unidos en trazo tenue por las conexiones que declara cada tema.`,
  pairs.length > 0 &&
    `En color, ${pairs.length === 1 ? 'el par' : `los ${pairs.length} pares`} de esta sección: ${pairs
      .map((edge) => `${edge.principle}, entre ${topicName(edge.a)} y ${topicName(edge.b)}`)
      .join('; ')}.`,
]
  .filter(Boolean)
  .join(' ');
const caption = `Los ${map.nodes.length} temas por entrega. En trazo tenue, las conexiones que declara cada tema; en color, los pares que explico abajo, cada uno con su principio sobre el enlace.`;
---

<Figure
  type="diagrama"
  showBadge={false}
  caption={caption}
  source={{
    text: 'Diagrama que dibujé con las conexiones de cada tema y los pares de esta sección',
  }}
>
  <svg
    data-testid="connection-map"
    class="mx-auto"
    width={MAP_WIDTH}
    height={map.height}
    viewBox={`0 0 ${MAP_WIDTH} ${map.height}`}
    role="img"
    aria-labelledby={TITLE_ID}
    aria-describedby={DESC_ID}
    font-family="var(--font-sans)"
  >
    <title id={TITLE_ID}>Mapa de conexiones entre los temas del portafolio</title>
    <desc id={DESC_ID}>{description}</desc>
    {map.columns.map(({ label, x }) => (
      <text
        x={x}
        y={COLUMN_BASELINE}
        text-anchor="middle"
        font-size={MAP_TYPE.column}
        font-weight="600"
        fill="var(--fg-muted)"
      >
        {label}
      </text>
    ))}
    <g fill="none" stroke="var(--fg-muted)" stroke-width={FAINT_STROKE} data-faint-edges>
      {faint.map((edge) => (
        <path d={edge.d} data-edge={`${edge.a}-${edge.b}`} />
      ))}
    </g>
    {map.nodes.map((node) => {
      const left = node.x - map.nodeWidth / 2;
      const color = nodeColor.get(node.number);
      return (
        <g data-map-node={node.number}>
          <rect
            x={left}
            y={node.y - map.nodeHeight / 2}
            width={map.nodeWidth}
            height={map.nodeHeight}
            rx={RADIUS}
            fill="var(--bg-elevated)"
            stroke={color ?? 'var(--border)'}
            stroke-width={color ? PAIR_NODE_STROKE : NODE_STROKE}
          />
          <text
            class="numbering"
            x={left + NODE_PAD_X}
            y={node.y + BASELINE_12}
            font-size={MAP_TYPE.number}
            fill="var(--fg-muted)"
          >
            {topicNumberLabel(node.number)}
          </text>
          <text
            x={left + NODE_PAD_X + NODE_NUMBER_WIDTH + NODE_NUMBER_GAP}
            y={node.y + BASELINE_14}
            font-size={MAP_TYPE.title}
            fill="var(--fg)"
          >
            {node.shortTitle}
          </text>
        </g>
      );
    })}
    {pairs.map((edge) => {
      const color = pairColor(edge.principle);
      const { label } = edge;
      return (
        <g data-pair-edge={`${edge.a}-${edge.b}`}>
          <path
            d={edge.d}
            fill="none"
            stroke={color}
            stroke-width={PAIR_STROKE}
            stroke-linecap="round"
          />
          <rect
            x={label.x - label.width / 2}
            y={label.y - label.height / 2}
            width={label.width}
            height={label.height}
            rx={label.height / 2}
            fill="var(--bg-elevated)"
            stroke={color}
            stroke-width={PAIR_NODE_STROKE}
          />
          <text
            x={label.x}
            y={label.y + BASELINE_12}
            text-anchor="middle"
            font-size={MAP_TYPE.label}
            font-weight="600"
            fill="var(--fg)"
          >
            {label.text}
          </text>
        </g>
      );
    })}
  </svg>
  <ul class="sticky left-0 mt-4 flex w-fit flex-wrap gap-x-6 gap-y-2 text-xs text-fg-muted">
    <li class="flex items-center gap-2">
      <span class="h-px w-6 shrink-0 bg-fg-muted" aria-hidden="true"></span>
      Conexión que declara cada tema
    </li>
    {pairs.map((edge) => (
      <li class="flex items-center gap-2">
        <span
          class="h-1 w-6 shrink-0 rounded-full"
          style={`background-color: ${pairColor(edge.principle)}`}
          aria-hidden="true"
        />
        <span>
          {edge.principle}: temas {edge.a} y {edge.b}
        </span>
      </li>
    ))}
  </ul>
</Figure>
