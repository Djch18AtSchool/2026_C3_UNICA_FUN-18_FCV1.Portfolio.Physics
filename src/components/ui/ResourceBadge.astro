---
import { RESOURCE_LABELS, type ResourceType } from '../../consigna';

interface Props {
  type?: ResourceType;
  /** Replaces the resource-type text (the mark and color still follow `type`). */
  label?: string;
}
const { type, label } = Astro.props;

// Resource accents are marks only (swatch and tint); the label text stays in fg for contrast.
// Full class names, so Tailwind's scanner sees every one.
const MARKS: Record<ResourceType, { swatch: string; tint: string }> = {
  simulacion: { swatch: 'bg-sim', tint: 'bg-sim/10 border-sim/40' },
  visualizacion: { swatch: 'bg-viz', tint: 'bg-viz/10 border-viz/40' },
  diagrama: { swatch: 'bg-diag', tint: 'bg-diag/10 border-diag/50' },
  multimedia: { swatch: 'bg-media', tint: 'bg-media/10 border-media/50' },
};
const mark = type ? MARKS[type] : undefined;
---

{type && mark ? (
  <span
    class:list={[
      'inline-flex items-center gap-2 rounded-base border px-2 py-0.5 text-sm text-fg',
      mark.tint,
    ]}
  >
    <span class:list={['size-2.5 shrink-0 rounded-[1px]', mark.swatch]} aria-hidden="true" />
    {label ?? RESOURCE_LABELS[type]}
  </span>
) : (
  <span class="inline-flex items-center gap-2 rounded-base border border-transparent px-2 py-0.5 text-sm text-fg-muted">
    <span
      class="size-2.5 shrink-0 rounded-[1px] border border-dashed border-fg-muted"
      aria-hidden="true"
    />
    Recurso por definir
  </span>
)}
