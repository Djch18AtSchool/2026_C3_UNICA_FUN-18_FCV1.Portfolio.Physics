---
import { RESOURCE_LABELS, type ResourceType } from '../../consigna';
import { RESOURCE_BADGE, RESOURCE_MARKS, RESOURCE_SWATCH } from './resourceMarks';

interface Props {
  type?: ResourceType;
  /** Replaces the resource-type text (the mark and color still follow `type`). */
  label?: string;
}
const { type, label } = Astro.props;

const mark = type ? RESOURCE_MARKS[type] : undefined;
/** The swatch of a resource still to be defined: an empty, dashed square. */
// scale-exempt: a dashed swatch marks a state (no resource yet), it separates no content
const UNDEFINED_SWATCH = 'size-3 shrink-0 rounded-base border border-dashed border-fg-muted';
---

{type && mark ? (
  <span class:list={[RESOURCE_BADGE, mark.tint]}>
    <span class:list={[RESOURCE_SWATCH, mark.swatch]} aria-hidden="true" />
    {label ?? RESOURCE_LABELS[type]}
  </span>
) : (
  <span class="inline-flex items-center gap-2 rounded-base border border-transparent px-2 py-1 text-sm text-fg-muted">
    <span class={UNDEFINED_SWATCH} aria-hidden="true" />
    Recurso por definir
  </span>
)}
