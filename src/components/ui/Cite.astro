---
/*
 * A numbered citation "[n]" that links to the entry in <Sources>. In MDX the list comes from the
 * frontmatter: <Cite id="nasa-g" sources={frontmatter.sources} />
 */
import type { Source } from '../../content/topicSchema';
import { formatSource, sourceIndex } from '../../lib/sources';

interface Props {
  id: string;
  sources: Source[];
}
const { id, sources } = Astro.props;

const source = sources.find((candidate) => candidate.id === id);
if (!source) throw new Error(`Cite: fuente "${id}" no declarada`);
const n = sourceIndex(sources, id);
const reference = formatSource(source);
// "[n]" alone tells a screen reader nothing; the name carries the reference, the text stays "[n]".
---

<a
  class="cite"
  href={`#fuente-${id}`}
  title={reference}
  aria-label={`Fuente ${n}: ${reference}`}
  set:text={`[${n}]`}
/>
