---
/*
 * A numbered figure ("Figura N.k", from the CSS counters of .topic-body) that frames a resource on
 * grid paper. The source line is mandatory. In MDX:
 *
 *   <Figure type="simulacion" caption="…" source={{ text: '…', url: '…' }}>
 *     <JumpSimulator client:visible />
 *   </Figure>
 *
 * `label` replaces the badge text while keeping the type's mark and color, e.g. for a supplementary
 * interactive figure that is not the topic's prescribed resource: label="Complemento interactivo".
 *
 * `showBadge={false}` drops the badge row for a resource that already shows its type, such as a
 * laboratory, whose LabShell header carries the same mark (one badge per figure).
 */
import ResourceBadge from './ResourceBadge.astro';
import type { ResourceType } from '../../consigna';

interface Props {
  type: ResourceType;
  caption: string;
  source: { text: string; url?: string };
  id?: string;
  /** Badge text in place of the resource-type name; the type still sets the mark and data-type. */
  label?: string;
  /** False when the content already shows its resource type (a LabShell laboratory). */
  showBadge?: boolean;
}
const { type, caption, source, id, label, showBadge = true } = Astro.props;

if (!source?.text?.trim()) throw new Error('Figure: falta la fuente');
---

<figure data-testid="figure" data-type={type} id={id} class="content-figure">
  {showBadge && (
    <div class="figure-head">
      <ResourceBadge type={type} label={label} />
    </div>
  )}
  <div
    class="figure-frame grid-paper"
    data-scroll-label="Figura {n} desplazable"
    data-scroll-number=".content-figure"
  >
    <slot />
  </div>
  <figcaption>
    <span class="figure-caption">{caption}</span>
    <p class="figure-source">
      Fuente: {source.url ? <a href={source.url}>{source.text}</a> : source.text}
    </p>
  </figcaption>
</figure>
