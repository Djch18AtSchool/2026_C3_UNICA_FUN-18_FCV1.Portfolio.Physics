---
/*
 * Links to the other portfolio topics and to the course sessions. The default slot holds the
 * connections prose, set under the heading and before the two lists, which stack vertically. In MDX:
 * <Connections related={frontmatter.related} classRefs={frontmatter.classRefs}>…</Connections>
 */
import { topicBySlug, type ConsignaTopic } from '../../consigna';
import type { ClassRef } from '../../content/topicSchema';
import { topicUrl } from '../../lib/url';
import { SECTION_HEADINGS } from '../../lib/sectionHeadings';

interface Props {
  related: string[];
  classRefs: ClassRef[];
}
const { related, classRefs } = Astro.props;

const relatedTopics: ConsignaTopic[] = related.map((slug) => {
  const topic = topicBySlug(slug);
  if (!topic) throw new Error(`Connections: el tema "${slug}" no existe en la consigna`);
  return topic;
});
// The sidebar outline and the search index list this section by the same text and id.
const heading = SECTION_HEADINGS.Connections;
---

<section data-testid="connections" class="connections" aria-labelledby={heading.slug}>
  <h2 id={heading.slug}>{heading.text}</h2>
  <slot />
  <div class="connections-lists">
    {relatedTopics.length > 0 && (
      <div>
        <h3>Con otros temas</h3>
        <ul class="connections-list">
          {relatedTopics.map((topic) => (
            <li>
              <span class="connections-number">Tema {topic.number}</span>
              <a href={topicUrl(topic.slug)}>{topic.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
    {classRefs.length > 0 && (
      <div>
        <h3>Con lo visto en clase</h3>
        <ul class="connections-list">
          {classRefs.map(({ module, topic, note }) => (
            <li class="margin-note">
              <span class="connections-number">{module}</span> · {topic}
              {note && <span class="connections-note">{note}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
