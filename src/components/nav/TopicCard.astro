---
import ResourceBadge from '../ui/ResourceBadge.astro';
import type { TopicSummary } from '../../lib/topics';
import { topicUrl } from '../../lib/url';

interface Props {
  topic: TopicSummary;
  /** The real product of the use case; shown only once the topic is published. */
  product?: string;
}
const { topic, product } = Astro.props;
const isPublished = topic.status === 'publicado';
// One entry of the notebook's table of contents: margin number, double margin rule, title,
// a dotted leader on wide screens, then resource and status. The whole row is the link target.
---

<article
  data-testid="topic-card"
  class="group relative grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 py-4 hover:bg-bg-elevated sm:grid-cols-[2.5rem_minmax(0,1fr)]"
>
  <span class="text-right font-mono text-lg leading-6 text-fg-muted" aria-hidden="true">
    {topic.number}
  </span>
  <div class="flex min-w-0 flex-col gap-2 border-l-[3px] border-double border-border pr-2 pl-4 md:flex-row md:items-center md:gap-4">
    <div class="min-w-0 md:max-w-[38rem]">
      <h3 class="text-base leading-6 font-medium">
        <span class="sr-only">Tema {topic.number}: </span>
        <a
          href={topicUrl(topic.slug)}
          data-testid="topic-link"
          class="text-fg no-underline after:absolute after:inset-0 group-hover:text-accent group-hover:underline"
        >
          {topic.title}
        </a>
      </h3>
      {isPublished && product && (
        <p class="text-sm text-fg-muted">
          Caso: <span class="text-fg">{product}</span>
        </p>
      )}
    </div>
    <span
      class="hidden min-w-8 flex-1 self-center border-b-2 border-dotted border-border md:block"
      aria-hidden="true"
    ></span>
    <div class="flex flex-col items-start gap-1.5 md:shrink-0 md:flex-row md:items-center md:gap-2">
      {isPublished ? (
        <ResourceBadge type={topic.resourceType} />
      ) : (
        <span class="text-sm text-fg-muted">Próximamente</span>
      )}
    </div>
  </div>
</article>
