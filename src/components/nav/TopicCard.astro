---
import ResourceBadge from '../ui/ResourceBadge.astro';
import type { TopicSummary } from '../../lib/topics';
import { topicUrl } from '../../lib/url';

interface Props {
  /** A topic of a phase with topics: future phases list no rows. */
  topic: TopicSummary;
}
const { topic } = Astro.props;
// One entry of the notebook's table of contents: margin number, double margin rule,
// title, a leader line on wide screens, then the resource type. The whole row is the link target.
// The number sits on the title's baseline: from md the row is as tall as the 30 px badge and
// centres the title in it, so a top-aligned number would ride 3 px high.
---

<article
  data-testid="topic-card"
  class="group relative grid grid-cols-[2rem_minmax(0,1fr)] items-baseline gap-x-3 py-4 hover:bg-bg-elevated sm:grid-cols-[3rem_minmax(0,1fr)]"
>
  <span class="text-right font-mono text-lg leading-6 text-fg-muted" aria-hidden="true">
    {topic.number}
  </span>
  <div class="flex min-w-0 flex-col gap-2 border-l-(length:--rule-double-width) border-double border-border pr-2 pl-4 md:flex-row md:items-center md:gap-4">
    <div class="min-w-0 md:max-w-[40rem]">
      <h3 class="text-base leading-6 font-medium">
        <span class="sr-only">Tema {topic.number}: </span>
        <a
          href={topicUrl(topic.slug)}
          data-testid="topic-link"
          class="text-fg no-underline after:absolute after:inset-0 group-hover:text-accent group-hover:underline"
        >
          {topic.title}
        </a>
      </h3>
    </div>
    <span
      class="hidden min-w-8 flex-1 self-center border-b border-border md:block"
      aria-hidden="true"
    ></span>
    <div class="flex flex-col items-start gap-2 md:shrink-0 md:flex-row md:items-center md:gap-2">
      <ResourceBadge type={topic.resourceType} />
    </div>
  </div>
</article>
