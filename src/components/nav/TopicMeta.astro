---
/*
 * The strip under a topic's concept: what the page is (resource badge, reading time,
 * last update) on the left, what the reader can do with it on the right. No rules frame it; the
 * spacing alone sets it apart from the concept above and the body below. It also embeds the
 * topic's Markdown for "Copiar Markdown". The halves share a row only where both fit with every
 * word; otherwise (beside the sidebar, on a phone) the tools wrap below.
 */
import ResourceBadge from '../ui/ResourceBadge.astro';
import ToolIcon from './ToolIcon';
import TopicTools from './TopicTools';
import { REPO_URL, SITE_URL, type ResourceType } from '../../consigna';
import { markdownSource, readingMinutes } from '../../lib/readingTime';
import { embedScriptText } from '../../lib/scriptText';
import { canonicalUrl, topicUrl } from '../../lib/url';

interface Props {
  slug: string;
  resourceType: ResourceType;
  /** Frontmatter `updated`: a calendar day parsed at UTC midnight. */
  updated: Date;
  /** The topic's raw MDX body. */
  body: string;
}
const { slug, resourceType, updated, body } = Astro.props;

const MARKDOWN_ELEMENT_ID = 'topic-markdown';
// Formatted in UTC so the calendar day never shifts with the build machine's zone.
const updatedLabel = new Intl.DateTimeFormat('es-CR', {
  dateStyle: 'medium',
  timeZone: 'UTC',
}).format(updated);
const updatedIso = updated.toISOString().slice(0, 10);
const sourceUrl = `${REPO_URL}/blob/main/src/content/topics/${slug}.mdx`;
const pageUrl = canonicalUrl(topicUrl(slug), SITE_URL);
const FACT = 'inline-flex items-center gap-1.5';
---

<div
  data-testid="topic-meta"
  class="mt-8 flex flex-col gap-y-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-6"
>
  <ul
    data-testid="topic-facts"
    class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-fg-muted"
  >
    <li class="flex">
      <ResourceBadge type={resourceType} />
    </li>
    <li class={FACT}>
      <ToolIcon name="clock" />
      <span>
        <span class="font-mono">{readingMinutes(body)}</span> min de lectura
      </span>
    </li>
    <li class={FACT}>
      <ToolIcon name="calendar" />
      <span>
        Actualizado <time datetime={updatedIso}>{updatedLabel}</time>
      </span>
    </li>
  </ul>
  <div class="-ml-2">
    <TopicTools
      client:idle
      url={pageUrl}
      githubUrl={sourceUrl}
      markdownElementId={MARKDOWN_ELEMENT_ID}
    />
  </div>
</div>
<script
  is:inline
  type="text/plain"
  id={MARKDOWN_ELEMENT_ID}
  set:html={embedScriptText(markdownSource(body))}
/>
