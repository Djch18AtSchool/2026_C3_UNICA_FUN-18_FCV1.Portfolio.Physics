---
import { PHASES, topicsByPhase, type Phase } from '../../consigna';
import { NAV_CLOSED, NAV_OPEN, phaseKey } from '../../lib/navState';
import type { SearchEntry, SearchHeading } from '../../lib/searchIndex';
import type { TopicSummary } from '../../lib/topics';
import SideNavPhase from './SideNavPhase.astro';
import SidebarSearch from './SidebarSearch';

interface Props {
  /** All topics, sorted by number. */
  topics: TopicSummary[];
  /** Slug of the page being shown; omitted on pages that are not a topic (404). */
  current?: string;
  /** Section headings of each published topic, by slug. */
  outlines: Record<string, SearchHeading[]>;
  /** Build-time search index (spec §9). */
  index: SearchEntry[];
  /** Phase open by default: the current topic's, or the delivery in progress. */
  currentPhase: Phase;
  /** Start with the drawer open on narrow screens (the 404 page, where the list is the way out). */
  isOpen?: boolean;
}
const { topics, current, outlines, index, currentPhase, isOpen = false } = Astro.props;

const currentTopic = topics.find((topic) => topic.slug === current);
const LIST_ID = 'sidenav-lista';
const phaseKeys = Object.fromEntries(PHASES.map((phase) => [phase, phaseKey(phase)]));
// One list serves both layouts: a closed <details> drawer on narrow screens (no JS), and on
// wide screens the summary hides and the content is forced visible (see the scoped style).
---

<nav aria-label="Temas" class="text-sm" data-sidenav>
  <details
    open={isOpen}
    class="sidenav group rounded-base border border-border bg-bg-elevated lg:border-0 lg:bg-transparent"
  >
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-medium lg:hidden [&::-webkit-details-marker]:hidden">
      <span>
        Temas del portafolio
        {currentTopic && (
          <span class="font-normal text-fg-muted">
            {' '}
            (tema <span class="font-mono">{currentTopic.number}</span> de{' '}
            <span class="font-mono">{topics.length}</span>)
          </span>
        )}
      </span>
      <svg
        class="size-4 shrink-0 text-fg-muted transition-transform group-open:rotate-180"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m4 6 4 4 4-4"></path>
      </svg>
    </summary>
    <div class="flex flex-col gap-5 border-t border-border px-2 pt-3 pb-4 lg:border-0 lg:p-0">
      <SidebarSearch client:idle index={index} listId={LIST_ID} />
      <div id={LIST_ID} class="flex flex-col gap-5">
        {PHASES.map((phase) => (
          <SideNavPhase
            phase={phase}
            topics={topicsByPhase(phase, topics)}
            current={current}
            outlines={outlines}
            isOpen={phase === currentPhase}
          />
        ))}
      </div>
    </div>
  </details>
</nav>
<!--
  Runs as soon as the list is parsed, before it is painted, and cannot import modules: mirrors
  readOpenPhases from src/lib/navState.ts (the server already opened the current phase).
  Storage is guarded because touching or reading it may throw.
-->
<script
  is:inline
  define:vars={{ keysByPhase: phaseKeys, openValue: NAV_OPEN, closedValue: NAV_CLOSED }}
>
  var storage = null;
  try {
    storage = window.localStorage;
  } catch (error) {}
  var phases = document.querySelectorAll('[data-sidenav] details[data-phase]');
  for (var i = 0; i < phases.length; i++) {
    var stored = null;
    try {
      stored = storage ? storage.getItem(keysByPhase[phases[i].dataset.phase]) : null;
    } catch (error) {}
    if (stored === openValue) phases[i].open = true;
    if (stored === closedValue) phases[i].open = false;
  }
</script>

<script>
  import { PHASES, type Phase } from '../../consigna';
  import { safeLocalStorage, writePhaseOpen } from '../../lib/navState';

  /** Fraction of the viewport from the top where a section counts as the one being read. */
  const READING_LINE = 0.3;
  /** Slack, in px, for deciding that the page is scrolled to the bottom (subpixel rounding). */
  const BOTTOM_SLACK_PX = 2;

  /**
   * Store only the reader's changes. Chromium can fire `toggle` for a <details> parsed with
   * `open`; an event whose state equals the last one seen is not a change and is skipped.
   */
  function rememberPhases(): void {
    document
      .querySelectorAll<HTMLDetailsElement>('[data-sidenav] details[data-phase]')
      .forEach((details) => {
        const phase = Number(details.dataset.phase) as Phase;
        if (!PHASES.includes(phase)) return;
        let lastOpen = details.open;
        details.addEventListener('toggle', () => {
          if (details.open === lastOpen) return;
          lastOpen = details.open;
          writePhaseOpen(safeLocalStorage(), phase, details.open);
        });
      });
  }

  function isScrolledToBottom(): boolean {
    const { scrollHeight } = document.documentElement;
    return window.scrollY + window.innerHeight >= scrollHeight - BOTTOM_SLACK_PX;
  }

  /**
   * Mark the current topic's outline link of the last section whose top passed the reading
   * line, or the last section once the page reaches its bottom (a short final section may never
   * reach the line). Without IntersectionObserver the outline simply has no marker.
   */
  function trackCurrentSection(): void {
    if (!('IntersectionObserver' in window)) return;
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>('[data-outline-current] [data-outline-link]'),
    ];
    const sections = links.flatMap((link) => {
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return target ? [{ link, target }] : [];
    });
    if (sections.length === 0) return;

    const update = () => {
      const line = window.innerHeight * READING_LINE;
      const passed = sections.filter(({ target }) => target.getBoundingClientRect().top <= line);
      const active = isScrolledToBottom() ? sections.at(-1)?.link : passed.at(-1)?.link;
      sections.forEach(({ link }) => {
        if (link === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    // The observers only say when something crosses; the rects and scroll position decide.
    // The first watches headings crossing the reading line, the second the page footer coming
    // fully into view, which is when the page reaches its bottom.
    const headingObserver = new IntersectionObserver(update, {
      rootMargin: `0px 0px -${(1 - READING_LINE) * 100}% 0px`,
    });
    const bottomObserver = new IntersectionObserver(update, { threshold: [0, 1] });
    const footer = document.querySelector('body > footer');
    const observe = () => {
      sections.forEach(({ target }) => headingObserver.observe(target));
      if (footer) bottomObserver.observe(footer);
    };
    observe();
    window.addEventListener('pagehide', () => {
      headingObserver.disconnect();
      bottomObserver.disconnect();
    });
    // A page restored from the back-forward cache resumes tracking.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) observe();
    });
  }

  rememberPhases();
  trackCurrentSection();
</script>

<style>
  /* Wide screens: the drawer is a permanent sidebar, open whatever the details state. */
  @media (width >= 64rem) {
    .sidenav::details-content {
      display: block;
      content-visibility: visible;
      block-size: auto;
    }
  }

  /*
   * Without ::details-content support the list cannot be forced open, so keep the summary on
   * wide screens too and the sidebar degrades to a working collapsed drawer. This unlayered
   * rule beats Tailwind's layered lg:hidden utility.
   */
  @supports not selector(::details-content) {
    @media (width >= 64rem) {
      .sidenav > summary {
        display: flex;
      }
    }
  }
</style>
