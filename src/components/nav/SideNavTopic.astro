---
/*
 * One topic in the sidebar: a flat row with its two-digit number. The current topic
 * always lists its sections below; SideNav's script marks the one being read.
 */
import { topicNumberLabel } from '../../lib/phases';
import type { SearchHeading } from '../../lib/searchIndex';
import type { TopicSummary } from '../../lib/topics';
import { topicUrl } from '../../lib/url';

interface Props {
  topic: TopicSummary;
  isCurrent: boolean;
  /** Section headings, listed only under the current topic. */
  headings: SearchHeading[];
}
const { topic, isCurrent, headings } = Astro.props;
const hasOutline = isCurrent && headings.length > 0;
const url = topicUrl(topic.slug);
---

<li>
  <a
    href={url}
    data-testid="topic-link"
    aria-current={isCurrent ? 'page' : undefined}
    class:list={[
      'grid grid-cols-[1.5rem_minmax(0,1fr)] items-baseline gap-x-1 border-l-2 py-1.5 pr-2 pl-1.5 leading-snug no-underline hover:bg-bg hover:text-fg',
      isCurrent ? 'border-accent bg-bg font-medium text-fg' : 'border-transparent text-fg',
    ]}
  >
    <span class="text-right font-mono text-xs text-fg-muted">{topicNumberLabel(topic.number)}</span>
    <span class="pl-1.5">{topic.shortTitle}</span>
  </a>
  {hasOutline && (
    <ul
      data-outline-current
      aria-label={`Secciones de ${topic.shortTitle}`}
      class="mt-0.5 mb-1.5 ml-[2.125rem] flex flex-col border-l border-border"
    >
      {headings.map((heading) => (
        <li>
          <a
            href={`${url}#${heading.anchor}`}
            data-outline-link
            class="-ml-px block border-l border-transparent py-1 pr-2 pl-3 leading-snug text-fg-muted no-underline hover:border-fg-muted hover:text-fg aria-[current=location]:border-accent aria-[current=location]:text-accent"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  )}
</li>
