---
/*
 * A 3 px bar pinned to the top of the viewport that fills as the topic is read: empty while the
 * page header is at the top, full once the end of the topic body ("Fuentes") reaches the bottom.
 * It is decoration for sighted readers, so assistive technology skips it, and without JS it
 * never shows. No transition: the fill follows the scroll exactly, so reduced motion needs no
 * special case. It sits above the desktop sticky bar (z-20) and below the skip link (z-50).
 */
---

<div
  class="reading-progress print:hidden"
  aria-hidden="true"
  data-reading-progress
  data-visible="false"
>
  <div class="reading-progress-fill"></div>
</div>

<script>
  import { readingProgress } from '../../lib/readingProgress';

  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const fill = bar?.querySelector<HTMLElement>('.reading-progress-fill');
  const head = document.querySelector<HTMLElement>('[data-topic-head]');
  const body = document.querySelector<HTMLElement>('.topic-body');

  /** Document Y of an element's edge, whatever the current scroll. */
  const documentTop = (element: HTMLElement) =>
    element.getBoundingClientRect().top + window.scrollY;
  const documentBottom = (element: HTMLElement) =>
    element.getBoundingClientRect().bottom + window.scrollY;

  if (bar && fill && head && body) {
    let frame = 0;
    // Labs, KaTeX and web fonts change the layout, so the anchors are re-measured, not cached.
    const update = () => {
      frame = 0;
      const progress = readingProgress({
        start: documentTop(head),
        end: documentBottom(body),
        scrollY: window.scrollY,
        viewportHeight: window.innerHeight,
      });
      fill.style.transform = `scaleX(${progress})`;
      bar.dataset.visible = 'true';
    };
    const schedule = () => {
      if (frame === 0) frame = requestAnimationFrame(update);
    };
    const resizeObserver = new ResizeObserver(schedule);
    const start = () => {
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      resizeObserver.observe(body);
      schedule();
    };
    const stop = () => {
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      resizeObserver.disconnect();
      cancelAnimationFrame(frame);
      frame = 0;
    };

    start();
    void document.fonts?.ready.then(schedule);
    window.addEventListener('pagehide', stop);
    // A page restored from the back-forward cache resumes tracking.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) start();
    });
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 40;
    height: 3px;
    pointer-events: none;
  }
  .reading-progress[data-visible='false'] {
    display: none;
  }
  .reading-progress-fill {
    height: 100%;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>
