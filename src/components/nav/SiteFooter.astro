---
/*
 * The page foot, closing the sheet the way the header opens it (a double rule): who made the
 * portfolio on the left and, on the right, the two tool icons that mirror the header's, the
 * repository and the theme. The padding is the same above and below. "Volver arriba" is the
 * floating BackToTop button, which stops above the foot instead of crossing it.
 * Only one <footer> sits under <body>: the sidebar's script watches it.
 */
import GithubIcon from '../ui/GithubIcon.astro';
import ThemeToggle from './ThemeToggle';
import { ICON_BUTTON, ICON_BUTTON_GLYPH } from './iconButton';
import { AUTHOR, COURSE, REPO_URL } from '../../consigna';

const REPO_LABEL = 'Repositorio en GitHub';
---

<footer class="mt-4 border-t-[3px] border-double border-border">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-6 text-sm leading-snug sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="flex flex-col gap-1">
      <p class="font-semibold tracking-tight text-balance text-fg">
        Portafolio de evidencias de Física&nbsp;I
      </p>
      <p class="text-fg-muted">
        {AUTHOR} · {COURSE.university}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <a
        href={REPO_URL}
        class={`inline-flex ${ICON_BUTTON}`}
        aria-label={REPO_LABEL}
        title={REPO_LABEL}
      >
        <GithubIcon class={ICON_BUTTON_GLYPH} />
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</footer>
