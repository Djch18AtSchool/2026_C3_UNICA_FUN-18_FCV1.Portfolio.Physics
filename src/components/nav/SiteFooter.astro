---
import { REPO_URL } from '../../consigna';

// The build date stands in for "last updated"; pinned to Costa Rica so CI (UTC) agrees.
const TIME_ZONE = 'America/Costa_Rica';
const buildDate = new Date();
const generatedLabel = new Intl.DateTimeFormat('es-CR', {
  dateStyle: 'long',
  timeZone: TIME_ZONE,
}).format(buildDate);
// en-CA formats dates as YYYY-MM-DD, the shape <time datetime> expects.
const generatedIso = new Intl.DateTimeFormat('en-CA', { timeZone: TIME_ZONE }).format(buildDate);
---

<footer class="mt-16 border-t border-border">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 pt-8 pb-10 text-sm text-fg-muted sm:flex-row sm:items-end sm:justify-between sm:px-6">
    <p>
      <a href={REPO_URL}>Ver repositorio</a>
    </p>
    <p>
      Sitio generado el <time datetime={generatedIso}>{generatedLabel}</time>
    </p>
  </div>
</footer>
