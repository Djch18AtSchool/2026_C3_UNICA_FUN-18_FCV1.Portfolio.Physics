---
import { REPO_URL } from '../../consigna';
import { BUILD_DATE_ISO, BUILD_DATE_LABEL } from '../../lib/buildDate';
---

<footer class="mt-16 border-t border-border">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 pt-8 pb-10 text-sm text-fg-muted sm:flex-row sm:items-end sm:justify-between sm:px-6">
    <p>
      <a href={REPO_URL}>Ver repositorio</a>
    </p>
    <p>
      Sitio generado el <time datetime={BUILD_DATE_ISO}>{BUILD_DATE_LABEL}</time>
    </p>
  </div>
</footer>
