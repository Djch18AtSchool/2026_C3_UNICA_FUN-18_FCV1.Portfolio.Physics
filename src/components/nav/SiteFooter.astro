---
/*
 * The page foot, closing the sheet the way the header opens it (a double rule): who made the
 * portfolio and, as a lone icon, where its repository lives. "Volver arriba" is the floating
 * BackToTop button, not part of the foot.
 * Only one <footer> sits under <body>: the sidebar's script watches it.
 */
import ToolIcon from './ToolIcon';
import { AUTHOR, COURSE, REPO_URL } from '../../consigna';

const REPO_LABEL = 'Repositorio en GitHub';
/**
 * The icon alone is a 44 px target on a phone and 40 px from `sm` up (the header buttons' size);
 * on a phone its negative margin lines the glyph up with the text above.
 */
const REPO_LINK =
  'inline-flex size-11 items-center justify-center rounded-base text-fg-muted no-underline transition-colors hover:bg-bg-elevated hover:text-fg max-sm:-ml-3 sm:size-10';
---

<!-- The bottom padding clears the floating BackToTop button, which sits over the page's end. -->
<footer class="mt-16 border-t-[3px] border-double border-border">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 pt-8 pb-20 text-sm leading-snug sm:flex-row sm:items-end sm:justify-between sm:px-6">
    <div class="flex flex-col gap-1">
      <p class="font-semibold tracking-tight text-balance text-fg">
        Portafolio de evidencias de Física&nbsp;I
      </p>
      <p class="text-fg-muted">
        {AUTHOR} · {COURSE.university}
      </p>
    </div>
    <a href={REPO_URL} class={REPO_LINK} aria-label={REPO_LABEL} title={REPO_LABEL}>
      <ToolIcon name="github" className="size-5" />
    </a>
  </div>
</footer>
