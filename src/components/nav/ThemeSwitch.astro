---
/*
 * A theme toggle plus the script that fixes its label before hydration, for either bar. The
 * server renders the light label; every toggle already in the document is fixed from data-theme
 * so the first paint states the right action (React keeps server attributes it believes already
 * match). Each placement carries its own copy, so a toggle is right as soon as it is parsed.
 */
import ThemeToggle from './ThemeToggle';
import { THEME_TOGGLE_LABELS } from '../../lib/theme';

interface Props {
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
---

<ThemeToggle client:load variant={variant} />
<script is:inline define:vars={{ labels: THEME_TOGGLE_LABELS }}>
  var root = document.documentElement;
  document.querySelectorAll('[data-theme-toggle]').forEach(function (toggle) {
    toggle.setAttribute('aria-label', root.dataset.theme === 'dark' ? labels.dark : labels.light);
  });
</script>
