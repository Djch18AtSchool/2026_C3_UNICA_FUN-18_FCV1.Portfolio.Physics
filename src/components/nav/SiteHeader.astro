---
import { AUTHOR } from '../../consigna';
import ThemeToggle from './ThemeToggle';
import { THEME_TOGGLE_LABELS } from '../../lib/theme';

const home = import.meta.env.BASE_URL;
---

<header class="border-b-[3px] border-double border-border">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <div class="min-w-0 leading-snug">
      <a href={home} class="font-semibold tracking-tight text-fg no-underline hover:text-accent">
        Portafolio de evidencias · Física I
      </a>
      <p class="text-sm text-fg-muted">{AUTHOR}</p>
    </div>
    <ThemeToggle client:load />
    <!--
      The server renders the light label; fix it from data-theme before hydration so the first
      paint names the right action (React keeps server attributes it believes already match).
    -->
    <script is:inline define:vars={{ labels: THEME_TOGGLE_LABELS }}>
      var toggle = document.querySelector('[data-theme-toggle]');
      if (toggle) {
        toggle.setAttribute(
          'aria-label',
          document.documentElement.dataset.theme === 'dark' ? labels.dark : labels.light,
        );
      }
    </script>
  </div>
</header>
