---
/*
 * A phase with topics, as a collapsible group. The server opens the default phase; the
 * inline script in SideNav then applies the remembered state before the list is painted.
 */
import type { Phase } from '../../consigna';
import type { SearchHeading } from '../../lib/searchIndex';
import type { TopicSummary } from '../../lib/topics';
import PhaseHeader from './PhaseHeader.astro';
import SideNavTopic from './SideNavTopic.astro';

interface Props {
  phase: Phase;
  label: string;
  /** This phase's topics, sorted by number. */
  topics: TopicSummary[];
  current?: string;
  outlines: Record<string, SearchHeading[]>;
  isOpen: boolean;
}
const { phase, label, topics, current, outlines, isOpen } = Astro.props;
const labelId = `sidenav-fase-${phase}`;
---

<details data-phase={phase} open={isOpen} class="group/phase">
  <PhaseHeader isFuture={false} label={label} labelId={labelId} />
  <ul aria-labelledby={labelId} class="flex flex-col">
    {topics.map((topic) => (
      <SideNavTopic
        topic={topic}
        isCurrent={topic.slug === current}
        headings={outlines[topic.slug] ?? []}
      />
    ))}
  </ul>
</details>
