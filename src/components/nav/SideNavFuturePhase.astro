---
/*
 * A phase without topics yet: a disabled header and a note, nothing more. Its topics arrive with
 * its consigna.
 */
import type { Phase } from '../../consigna';
import PhaseHeader from './PhaseHeader.astro';

interface Props {
  phase: Phase;
  label: string;
}
const { phase, label } = Astro.props;
---

<div data-phase-future={phase}>
  <PhaseHeader isFuture label={label} />
  <p class="px-2 text-[12px] leading-5 text-fg-muted">se publica con su consigna</p>
</div>
