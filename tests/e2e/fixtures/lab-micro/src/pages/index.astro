---
/**
 * Test page for the labs' microinteractions (tests/e2e/microinteractions.spec.ts, D4): a lab with
 * presets (the transition), a plot with three series (the legend's highlight) and a draggable
 * knob (its focus ring and its growth while dragged). ?theme=dark switches the theme. Never part
 * of the site.
 *
 * The width is frozen like lab-time's (867 px with 18 px sides): this page only tries the pieces;
 * the labs that use them are checked on their own pages (lab-preset-transition.spec.ts and
 * lab-microinteractions.spec.ts).
 */
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'katex/dist/katex.min.css';
import '../fixture.css';
import MicroLabFixture from '../MicroLabFixture';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Microinteracciones (prueba)</title>
    <script is:inline>
      document.documentElement.dataset.theme =
        new URLSearchParams(location.search).get('theme') === 'dark' ? 'dark' : 'light';
    </script>
  </head>
  <body class="bg-bg text-fg">
    <main class="mx-auto w-full max-w-[867px] px-[18px] py-8">
      <MicroLabFixture client:load />
    </main>
  </body>
</html>
