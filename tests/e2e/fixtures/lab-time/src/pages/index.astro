---
/**
 * Test page for the shared time pieces (tests/e2e/time-scale.spec.ts): a lab with a clock, events
 * on its transport and the time-scale badge. ?theme=dark switches the theme. Never part of the site.
 *
 * The width is frozen: 867 px with 18 px sides gives the lab the 831 px a topic page gave it at
 * 1 280 (and 324 px at 360), measured on 2026-11-10 (raíz de 17 px). This page does not follow a
 * later change of the topic layout; the real labs that use these pieces are checked on their own
 * pages (lab-shell.spec.ts and each topic's spec), and this one only tries the pieces themselves.
 */
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'katex/dist/katex.min.css';
import '../fixture.css';
import TimeLabFixture from '../TimeLabFixture';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Piezas de tiempo (prueba)</title>
    <script is:inline>
      document.documentElement.dataset.theme =
        new URLSearchParams(location.search).get('theme') === 'dark' ? 'dark' : 'light';
    </script>
  </head>
  <body class="bg-bg text-fg">
    <main class="mx-auto w-full max-w-[867px] px-[18px] py-8">
      <TimeLabFixture client:load />
    </main>
  </body>
</html>
