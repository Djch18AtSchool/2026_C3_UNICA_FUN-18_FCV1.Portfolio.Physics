---
/**
 * Test page for the shared time pieces (tests/e2e/time-scale.spec.ts): a lab with a clock, events
 * on its transport and the time-scale badge, at the width a topic page gives its lab (831 px at
 * 1 280, 324 px at 360). ?theme=dark switches the theme. Never part of the site.
 */
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'katex/dist/katex.min.css';
import '../fixture.css';
import TimeLabFixture from '../TimeLabFixture';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Piezas de tiempo (prueba)</title>
    <script is:inline>
      document.documentElement.dataset.theme =
        new URLSearchParams(location.search).get('theme') === 'dark' ? 'dark' : 'light';
    </script>
  </head>
  <body class="bg-bg text-fg">
    <main class="mx-auto w-full max-w-[867px] px-[18px] py-8">
      <TimeLabFixture client:load />
    </main>
  </body>
</html>
